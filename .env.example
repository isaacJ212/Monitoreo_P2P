# ==============================================================================
# BASE DE DATOS Y PROGRAMADOR
# ==============================================================================
# Opción 1: SQLite local (ideal para desarrollo local en tu PC)
# DATABASE_URL=sqlite:///./p2p_monitor.db
#
# Opción 2: PostgreSQL / Supabase (RECOMENDADO para despliegue en VM Azure / Producción)
# Ve a tu proyecto de Supabase -> Project Settings -> Database -> Connection string (URI)
# Ejemplo con Connection Pooler (puerto 6543 o 5432):
# DATABASE_URL=postgresql://postgres.[TU_PROYECTO]:[TU_CONTRASEÑA]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=
POLL_INTERVAL_MINUTES=3
ALERT_COOLDOWN_MINUTES=20

# ==============================================================================
# FILTRO DE COMERCIANTES SEGUROS
# ==============================================================================
MIN_FINISH_RATE=0.90
MIN_MONTH_ORDERS=10
ONLY_VERIFIED_MERCHANTS=false

# ==============================================================================
# ALERTAS VÍA CORREO ELECTRÓNICO (SMTP GMAIL U OTRO)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_16_digitos
ALERT_EMAIL_TO=destino@gmail.com

# ==============================================================================
# ALERTAS VÍA WHATSAPP CON WAHA (WhatsApp HTTP API)
# ==============================================================================
WAHA_API_URL=http://localhost:3000/api/sendText
WAHA_API_KEY=

# NÚMERO A (Emisor / Bot): Es el nombre de la sesión vinculada con el código QR en WAHA
WAHA_SESSION=Binance

# NÚMERO B (Receptor / Destinatario que recibirá las notificaciones en su teléfono):
# Coloca el número de teléfono con código de país (ej: 50588888888)
# Puedes colocar un solo número o varios separados por coma (ej: 50588888888, 50577777777)
WHATSAPP_RECIPIENT_NUMBER=50588888888

# ==============================================================================
# TWILIO (OPCIONAL COMO FALLBACK)
# ==============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=

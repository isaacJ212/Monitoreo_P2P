# ==============================================================================
# BASE DE DATOS Y PROGRAMADOR
# ==============================================================================
# Por defecto SQLite (archivo local). Si usas PostgreSQL:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/p2p_monitor
DATABASE_URL=sqlite:///./p2p_monitor.db
POLL_INTERVAL_MINUTES=3
ALERT_COOLDOWN_MINUTES=20

# ==============================================================================
# FILTRO DE COMERCIANTES SEGUROS
# ==============================================================================
MIN_FINISH_RATE=0.90
MIN_MONTH_ORDERS=10
ONLY_VERIFIED_MERCHANTS=false

# ==============================================================================
# ALERTAS VÍA CORREO ELECTRÓNICO (SMTP GMAIL U OTRO)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_16_digitos
ALERT_EMAIL_TO=destino@gmail.com

# ==============================================================================
# ALERTAS VÍA WHATSAPP CON WAHA (WhatsApp HTTP API)
# ==============================================================================
# Si usas Docker Compose, usa: http://waha:3008/api/sendText
# Si corres en tu PC local, usa: http://localhost:3008/api/sendText
WAHA_API_URL=http://localhost:3008/api/sendText
WAHA_SESSION=default
WAHA_API_KEY=
WAHA_CHAT_ID=50588888888@c.us

# ==============================================================================
# TWILIO (OPCIONAL COMO FALLBACK)
# ==============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
